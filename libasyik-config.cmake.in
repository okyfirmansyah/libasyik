@PACKAGE_INIT@

# libasyik's imported target links these, so they must be found before it is
# loaded; the SOCI lookup depends on how libasyik was built
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(Boost COMPONENTS fiber context date_time url)
set(_libasyik_with_soci @LIBASYIK_ENABLE_SOCI@)
if(_libasyik_with_soci)
    find_dependency(SOCI)
endif()
unset(_libasyik_with_soci)

include("${CMAKE_CURRENT_LIST_DIR}/libasyik-targets.cmake")
check_required_components(libasyik)
